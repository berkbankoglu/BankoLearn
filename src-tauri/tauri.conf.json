{
  "productName": "Banko Learn",
  "version": "1.0.0",
  "identifier": "com.berkbankoglu.bankolearn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "publisher": "Berk Bankoglu",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "app": {
    "windows": [
      {
        "title": "Banko Learn",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false,
        "url": "index.html",
        "center": true
      },
      {
        "title": "Kana Practice",
        "label": "kana-popup",
        "width": 420,
        "height": 750,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "url": "kana.html",
        "center": true,
        "skipTaskbar": true
      }
    ],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.anthropic.com https://*.supabase.co wss://*.supabase.co; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; media-src 'self' data:",
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main app capabilities",
          "windows": [
            "main"
          ],
          "permissions": [
            "dialog:default",
            "dialog:allow-save",
            "dialog:allow-open",
            "fs:default",
            "fs:allow-read-text-file",
            "fs:allow-write-text-file",
            "notification:default",
            "core:event:default",
            "core:window:allow-create",
            "core:window:allow-close",
            "core:window:allow-minimize",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-is-maximized",
            "core:window:allow-is-fullscreen",
            "core:window:allow-set-fullscreen",
            "core:window:allow-set-always-on-top",
            "core:window:allow-start-dragging",
            "core:window:allow-set-position",
            "core:window:allow-outer-position",
            "core:window:allow-outer-size",
            "core:window:allow-scale-factor",
            "core:window:allow-destroy",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-is-visible",
            "core:window:allow-set-focus",
            "core:window:allow-set-size",
            "core:window:allow-set-decorations",
            "core:window:allow-get-all-windows",
            "core:window:allow-unminimize",
            "core:window:allow-internal-toggle-maximize",
            "deep-link:default",
            "updater:default",
            "process:allow-restart"
          ]
        },
        {
          "identifier": "kana-popup-capability",
          "description": "Kana practice popup — no filesystem/dialog/notification access, it only shows a small always-on-top word list",
          "windows": [
            "kana-popup"
          ],
          "permissions": [
            "core:window:allow-hide",
            "core:window:allow-set-always-on-top",
            "core:window:allow-start-dragging",
            "core:window:allow-set-position",
            "core:window:allow-outer-position",
            "core:window:allow-outer-size",
            "core:window:allow-scale-factor"
          ]
        }
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "bankolearn"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0MEUzQjU0N0Y4MUEyNUMKUldSY29vRi9WRHNPTkpIYjlJL2xDNldKUENGQ2hnV0IrbEdpSUFMOXBNLzRiYnIzR0ZTSlVabGUK",
      "endpoints": [
        "https://github.com/berkbankoglu/BankoLearn/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
